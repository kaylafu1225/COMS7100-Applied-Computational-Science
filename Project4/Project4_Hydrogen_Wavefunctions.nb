(* Content-type: application/vnd.wolfram.mathematica *)

(** Wolfram Notebook File **)

Notebook[{
Cell["Hydrogen atom wavefunctions", "Title"],

Cell["Project 4   /   radial amplitudes, real angular functions and orbital slices", "Subtitle"],

Cell["Start at the top. Click inside each Input cell and press Shift+Enter. Sections A\:2013C work through the 1s and 2p_z examples. The final section runs every allowed state through n = 4. Save the evaluated notebook to keep its figures and tables.", "Text"],

Cell["Lengths are in Bohr radii (a\:2080 = 1). The radial probability in a shell of thickness dr is r\:00b2R\:00b2 dr. The angular and full-orbital plots use the sign of the real wavefunction.", "Text"],

Cell["Setup", "Section"],

Cell["Keep x, y, z and r symbolic. The following reset is restricted to this notebook\:2019s cell context.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", RowBox[{"x", ",", "y", ",", "z", ",", "r", ",", "u", ",", "v", ",", "th", ",", "ph", ",", "n", ",", "ell", ",", "m", ",", "radius", ",", "radialCore", ",", "radial", ",", "\[IndentingNewLine]", "radialNorm", ",", "radialPlot", ",", "angularScale", ",", "azimuth", ",", "realY", ",", "angularNorm", ",", "solidY", ",", "\[IndentingNewLine]", "angularXYZ", ",", "axisDrawing", ",", "angularPlot", ",", "psiXYZ", ",", "fullNorm", ",", "slicePanel", ",", "sliceRow", ",", "\[IndentingNewLine]", "radialPairs", ",", "angularPairs", ",", "orbitals", ",", "normTable"}], "]"}], ";"}]], "Input"],

Cell["A   /   Radial wavefunctions", "Section"],

Cell["The handout\:2019s equations (74), (75) and (78) give the radial function with Mathematica\:2019s generalized LaguerreL. The factor r^ell is kept separate because it will cancel a denominator in part C.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"radialCore", "[", RowBox[{"n_", ",", "ell_", ",", "r_"}], "]"}], ":=", RowBox[{"(", RowBox[{"2", "/", "n"}], ")"}], "^", RowBox[{"(", RowBox[{"ell", "+", "3", "/", "2"}], ")"}], "*", "\[IndentingNewLine]", RowBox[{"Sqrt", "[", RowBox[{RowBox[{"Factorial", "[", RowBox[{"n", "-", "ell", "-", "1"}], "]"}], "/", RowBox[{"(", RowBox[{"2", "*", "n", "*", RowBox[{"Factorial", "[", RowBox[{"n", "+", "ell"}], "]"}]}], ")"}]}], "]"}], "*", "\[IndentingNewLine]", RowBox[{"Exp", "[", RowBox[{"-", "r", "/", "n"}], "]"}], "*", RowBox[{"LaguerreL", "[", RowBox[{"n", "-", "ell", "-", "1", ",", "2", "*", "ell", "+", "1", ",", "2", "*", "r", "/", "n"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"radial", "[", RowBox[{"n_", ",", "ell_", ",", "r_"}], "]"}], ":=", RowBox[{"If", "[", RowBox[{"ell", "==", "0", ",", "1", ",", "r", "^", "ell"}], "]"}], "*", RowBox[{"radialCore", "[", RowBox[{"n", ",", "ell", ",", "r"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"radialNorm", "[", RowBox[{"n_", ",", "ell_"}], "]"}], ":=", RowBox[{"radialNorm", "[", RowBox[{"n", ",", "ell"}], "]"}], "=", "\[IndentingNewLine]", RowBox[{"Integrate", "[", RowBox[{"r", "^", "2", "*", RowBox[{"radial", "[", RowBox[{"n", ",", "ell", ",", "r"}], "]"}], "^", "2", ",", RowBox[{"{", RowBox[{"r", ",", "0", ",", "Infinity"}], "}"}]}], "]"}], ";"}]], "Input"],

Cell["Start with the 1s state", "Subsection"],

Cell["For (n, \:2113) = (1, 0) the three entries below should be 2 exp(\:2212r), 4r\:00b2 exp(\:22122r), and 1. The radial amplitude is largest at the nucleus, while the probability per unit radius reaches its maximum at r = 1.", "Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"radial", "[", RowBox[{"1", ",", "0", ",", "r"}], "]"}], ",", "r", "^", "2", "*", RowBox[{"radial", "[", RowBox[{"1", ",", "0", ",", "r"}], "]"}], "^", "2", ",", RowBox[{"radialNorm", "[", RowBox[{"1", ",", "0"}], "]"}]}], "}"}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"radialPlot", "[", RowBox[{"n_", ",", "ell_"}], "]"}], ":=", RowBox[{"Plot", "[", RowBox[{"\[IndentingNewLine]", RowBox[{"Evaluate", "[", RowBox[{"{", RowBox[{RowBox[{"radial", "[", RowBox[{"n", ",", "ell", ",", "r"}], "]"}], ",", "r", "^", "2", "*", RowBox[{"radial", "[", RowBox[{"n", ",", "ell", ",", "r"}], "]"}], "^", "2"}], "}"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"r", ",", "0", ",", "3", "*", "n", "^", "2", "+", "3"}], "}"}], ",", "PlotRange", "->", "All", ",", "Frame", "->", "True", ",", "Axes", "->", "False", ",", "\[IndentingNewLine]", "FrameLabel", "->", RowBox[{"{", RowBox[{"\"r (Bohr radii)\"", ",", "\"Amplitude or radial probability density\""}], "}"}], ",", "\[IndentingNewLine]", "PlotStyle", "->", RowBox[{"{", RowBox[{RowBox[{"Directive", "[", RowBox[{"Blue", ",", "Thick"}], "]"}], ",", RowBox[{"Directive", "[", RowBox[{RowBox[{"Darker", "[", "Red", "]"}], ",", "Thick"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", "PlotLegends", "->", RowBox[{"Placed", "[", RowBox[{RowBox[{"{", RowBox[{"\"R(r)\"", ",", "\"r^2 R(r)^2\""}], "}"}], ",", "Below"}], "]"}], ",", "\[IndentingNewLine]", "PlotLabel", "->", RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"n = \"", ",", "n", ",", "\"    l = \"", ",", "ell"}], "}"}], "]"}], ",", "ImageSize", "->", "420"}], "]"}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"radialPlot", "[", RowBox[{"1", ",", "0"}], "]"}]], "Input"],

Cell["B   /   Real spherical harmonics", "Section"],

Cell["Use the real basis in equation (100). Positive m uses cosine, negative m uses sine, and m = 0 has no azimuthal factor. Mathematica\:2019s associated LegendreP includes the Condon\:2013Shortley phase, so equation (100) includes the factor (\:22121)^|m|.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"angularScale", "[", RowBox[{"ell_", ",", "k_"}], "]"}], ":=", RowBox[{"Sqrt", "[", RowBox[{"\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{"k", "==", "0", ",", "1", ",", "2"}], "]"}], "*", RowBox[{"(", RowBox[{"2", "*", "ell", "+", "1"}], ")"}], "*", RowBox[{"Factorial", "[", RowBox[{"ell", "-", "k"}], "]"}], "/", RowBox[{"(", RowBox[{"4", "*", "Pi", "*", RowBox[{"Factorial", "[", RowBox[{"ell", "+", "k"}], "]"}]}], ")"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"azimuth", "[", RowBox[{"m_", ",", "ph_"}], "]"}], ":=", RowBox[{"Which", "[", RowBox[{"m", ">", "0", ",", RowBox[{"Cos", "[", RowBox[{"m", "*", "ph"}], "]"}], ",", "m", "<", "0", ",", RowBox[{"Sin", "[", RowBox[{"-", "m", "*", "ph"}], "]"}], ",", "True", ",", "1"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"realY", "[", RowBox[{"ell_", ",", "m_", ",", "th_", ",", "ph_"}], "]"}], ":=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"k", "=", RowBox[{"Abs", "[", "m", "]"}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"(", RowBox[{"-", "1"}], ")"}], "^", "k", "*", RowBox[{"angularScale", "[", RowBox[{"ell", ",", "k"}], "]"}], "*", RowBox[{"LegendreP", "[", RowBox[{"ell", ",", "k", ",", RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "*", RowBox[{"azimuth", "[", RowBox[{"m", ",", "ph"}], "]"}]}], "]"}], ";"}]], "Input"],

Cell["For the angular normalization use u = cos(\:03b8). The angular integral is a product of a polar integral over \:22121 \:2264 u \:2264 1 and an azimuthal integral over 0 \:2264 \:03c6 \:2264 2\:03c0. Evaluate it before applying the plotting factor exp(\:2212r).", "Text"],

Cell[BoxData[RowBox[{RowBox[{"angularNorm", "[", RowBox[{"ell_", ",", "m_"}], "]"}], ":=", RowBox[{"angularNorm", "[", RowBox[{"ell", ",", "m"}], "]"}], "=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"k", "=", RowBox[{"Abs", "[", "m", "]"}], ",", "u", ",", "ph"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"angularScale", "[", RowBox[{"ell", ",", "k"}], "]"}], "^", "2", "*", "\[IndentingNewLine]", RowBox[{"Integrate", "[", RowBox[{RowBox[{"LegendreP", "[", RowBox[{"ell", ",", "k", ",", "u"}], "]"}], "^", "2", ",", RowBox[{"{", RowBox[{"u", ",", "-", "1", ",", "1"}], "}"}]}], "]"}], "*", "\[IndentingNewLine]", RowBox[{"Integrate", "[", RowBox[{RowBox[{"azimuth", "[", RowBox[{"m", ",", "ph"}], "]"}], "^", "2", ",", RowBox[{"{", RowBox[{"ph", ",", "0", ",", "2", "*", "Pi"}], "}"}]}], "]"}]}], "]"}], ";"}]], "Input"],

Cell["Convert the angular function to Cartesian coordinates", "Subsection"],

Cell["Define S = r^ell y. This is a polynomial in x, y, z. Its azimuthal factor is the real or imaginary part of (x + iy)^|m|. By the associated Legendre derivative formula (89), the remaining factor is r^(ell\:2212|m|) times the |m|-th derivative of P_ell, evaluated at z/r. Expanding before substituting r leaves only nonnegative even powers of r.", "Text"],

Cell[BoxData[RowBox[{"radius", "=", RowBox[{"Sqrt", "[", RowBox[{"x", "^", "2", "+", "y", "^", "2", "+", "z", "^", "2"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"solidY", "[", RowBox[{"ell_", ",", "m_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"k", "=", RowBox[{"Abs", "[", "m", "]"}], ",", "t", ",", "s", ",", "dp", ",", "az", ",", "polar"}], "}"}], ",", "\[IndentingNewLine]", "dp", "=", RowBox[{"D", "[", RowBox[{RowBox[{"LegendreP", "[", RowBox[{"ell", ",", "t"}], "]"}], ",", RowBox[{"{", RowBox[{"t", ",", "k"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", "az", "=", RowBox[{"Which", "[", RowBox[{"k", "==", "0", ",", "1", ",", "m", ">", "0", ",", RowBox[{"ComplexExpand", "[", RowBox[{"Re", "[", RowBox[{RowBox[{"(", RowBox[{"x", "+", "I", "*", "y"}], ")"}], "^", "k"}], "]"}], "]"}], ",", "\[IndentingNewLine]", "True", ",", RowBox[{"ComplexExpand", "[", RowBox[{"Im", "[", RowBox[{RowBox[{"(", RowBox[{"x", "+", "I", "*", "y"}], ")"}], "^", "k"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "polar", "=", RowBox[{"Expand", "[", RowBox[{"s", "^", RowBox[{"(", RowBox[{"ell", "-", "k"}], ")"}], "*", RowBox[{"(", RowBox[{"dp", "/.", "t", "->", "z", "/", "s"}], ")"}]}], "]"}], "/.", "s", "->", "radius", ";", "\[IndentingNewLine]", RowBox[{"Expand", "[", RowBox[{RowBox[{"angularScale", "[", RowBox[{"ell", ",", "k"}], "]"}], "*", "az", "*", "polar"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"angularXYZ", "[", RowBox[{"ell_", ",", "m_"}], "]"}], ":=", RowBox[{"If", "[", RowBox[{"ell", "==", "0", ",", RowBox[{"solidY", "[", RowBox[{"ell", ",", "m"}], "]"}], ",", RowBox[{"solidY", "[", RowBox[{"ell", ",", "m"}], "]"}], "/", "radius", "^", "ell"}], "]"}], ";"}]], "Input"],

Cell["For (\:2113, m) = (1, 0), the expressions should be proportional to cos(\:03b8) and z/r, respectively. The last entry should be 1.", "Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"realY", "[", RowBox[{"1", ",", "0", ",", "th", ",", "ph"}], "]"}], ",", RowBox[{"angularXYZ", "[", RowBox[{"1", ",", "0"}], "]"}], ",", RowBox[{"angularNorm", "[", RowBox[{"1", ",", "0"}], "]"}]}], "}"}]], "Input"],

Cell["Draw the isosurfaces of exp(\:2212r)y at \:00b10.09. Blue indicates a negative value and red a positive value. The \:2113 = 0 harmonic is positive everywhere, so it has a single red surface. The arrows intersect at the origin.", "Text"],

Cell[BoxData[RowBox[{"axisDrawing", "=", RowBox[{"Graphics3D", "[", RowBox[{"{", RowBox[{RowBox[{"GrayLevel", "[", "0.36", "]"}], ",", "Thin", ",", RowBox[{"Arrowheads", "[", "0.022", "]"}], ",", "\[IndentingNewLine]", RowBox[{"Arrow", "[", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"-", "2.35", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"2.35", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", RowBox[{"Text", "[", RowBox[{"\"x\"", ",", RowBox[{"{", RowBox[{"2.52", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Arrow", "[", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "-", "2.35", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "2.35", ",", "0"}], "}"}]}], "}"}], "]"}], ",", RowBox[{"Text", "[", RowBox[{"\"y\"", ",", RowBox[{"{", RowBox[{"0", ",", "2.52", ",", "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Arrow", "[", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", ",", "-", "2.35"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "2.35"}], "}"}]}], "}"}], "]"}], ",", RowBox[{"Text", "[", RowBox[{"\"z\"", ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "2.52"}], "}"}]}], "]"}]}], "}"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"angularPlot", "[", RowBox[{"ell_", ",", "m_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"field", ",", "levels", ",", "colors"}], "}"}], ",", "\[IndentingNewLine]", "field", "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"raw", "=", RowBox[{"Exp", "[", RowBox[{"-", "radius"}], "]"}], "*", RowBox[{"angularXYZ", "[", RowBox[{"ell", ",", "m"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{"ell", "==", "0", ",", "raw", ",", RowBox[{"If", "[", RowBox[{"radius", "==", "0", ",", "0", ",", "raw"}], "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "levels", "=", RowBox[{"If", "[", RowBox[{"ell", "==", "0", ",", RowBox[{"{", "0.09", "}"}], ",", RowBox[{"{", RowBox[{"-", "0.09", ",", "0.09"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", "colors", "=", RowBox[{"If", "[", RowBox[{"ell", "==", "0", ",", RowBox[{"{", "Red", "}"}], ",", RowBox[{"{", RowBox[{"Blue", ",", "Red"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Show", "[", RowBox[{RowBox[{"ContourPlot3D", "[", RowBox[{RowBox[{"Evaluate", "[", "field", "]"}], ",", RowBox[{"{", RowBox[{"x", ",", "-", "2.6", ",", "2.6"}], "}"}], ",", RowBox[{"{", RowBox[{"y", ",", "-", "2.6", ",", "2.6"}], "}"}], ",", RowBox[{"{", RowBox[{"z", ",", "-", "2.6", ",", "2.6"}], "}"}], ",", "\[IndentingNewLine]", "Contours", "->", "levels", ",", "ContourStyle", "->", "colors", ",", "Mesh", "->", "None", ",", "\[IndentingNewLine]", "PlotPoints", "->", "30", ",", "MaxRecursion", "->", "1"}], "]"}], ",", "axisDrawing", ",", "\[IndentingNewLine]", "Axes", "->", "False", ",", "Boxed", "->", "False", ",", "Lighting", "->", "\"Neutral\"", ",", "SphericalRegion", "->", "True", ",", "\[IndentingNewLine]", "PlotRange", "->", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"-", "2.65", ",", "2.65"}], "}"}], ",", RowBox[{"{", RowBox[{"-", "2.65", ",", "2.65"}], "}"}], ",", RowBox[{"{", RowBox[{"-", "2.65", ",", "2.65"}], "}"}]}], "}"}], ",", "ImageSize", "->", "340", ",", "\[IndentingNewLine]", "PlotLabel", "->", RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"l = \"", ",", "ell", ",", "\"    m = \"", ",", "m"}], "}"}], "]"}]}], "]"}]}], "]"}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"angularPlot", "[", RowBox[{"1", ",", "0"}], "]"}]], "Input"],

Cell["C   /   The complete wavefunction", "Section"],

Cell["Multiply R by the real angular function. Since R = r^ell radialCore and y = solidY/r^ell, the Cartesian product is radialCore \:00d7 solidY. This form includes the correct limiting value at the nucleus. Full-space normalization separates into the radial integral from A times the angular integral from B.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"psiXYZ", "[", RowBox[{"n_", ",", "ell_", ",", "m_"}], "]"}], ":=", RowBox[{"radialCore", "[", RowBox[{"n", ",", "ell", ",", "radius"}], "]"}], "*", RowBox[{"solidY", "[", RowBox[{"ell", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"fullNorm", "[", RowBox[{"n_", ",", "ell_", ",", "m_"}], "]"}], ":=", RowBox[{"radialNorm", "[", RowBox[{"n", ",", "ell"}], "]"}], "*", RowBox[{"angularNorm", "[", RowBox[{"ell", ",", "m"}], "]"}], ";"}]], "Input"],

Cell["Use the 2p_z orbital to check the coordinate planes", "Subsection"],

Cell["For (2, 1, 0), \:03c8 = z exp(\:2212r/2)/(4\:221a(2\:03c0)). Setting z = 0 makes the entire xy slice zero. The xz and yz slices should look alike, with the red lobe above the nucleus. Check the three entries below: wavefunction, xy slice, and full normalization.", "Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Simplify", "[", RowBox[{"psiXYZ", "[", RowBox[{"2", ",", "1", ",", "0"}], "]"}], "]"}], ",", RowBox[{"psiXYZ", "[", RowBox[{"2", ",", "1", ",", "0"}], "]"}], "/.", "z", "->", "0", ",", RowBox[{"fullNorm", "[", RowBox[{"2", ",", "1", ",", "0"}], "]"}]}], "}"}]], "Input"],

Cell["The figures display the signed amplitude \:03c8. Within each row all three planes use the same color scale. White means zero. A square-root color stretch makes weaker outer lobes visible. An exactly zero slice is labeled as a nodal plane.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"slicePanel", "[", RowBox[{"expr_", ",", "labels_", ",", "width_", ",", "peak_"}], "]"}], ":=", RowBox[{"If", "[", RowBox[{"expr", "===", "0", ",", "\[IndentingNewLine]", RowBox[{"Graphics", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", RowBox[{"Text", "[", RowBox[{RowBox[{"Style", "[", RowBox[{"\"nodal plane (psi = 0)\"", ",", "11"}], "]"}], ",", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", "Frame", "->", "True", ",", "FrameLabel", "->", "labels", ",", "AspectRatio", "->", "1", ",", "Background", "->", "White", ",", "\[IndentingNewLine]", "PlotRange", "->", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"-", "width", ",", "width"}], "}"}], ",", RowBox[{"{", RowBox[{"-", "width", ",", "width"}], "}"}]}], "}"}], ",", "PlotRangePadding", "->", "None", ",", "\[IndentingNewLine]", "ImagePadding", "->", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"46", ",", "8"}], "}"}], ",", RowBox[{"{", RowBox[{"38", ",", "8"}], "}"}]}], "}"}], ",", "ImageSize", "->", "242"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"DensityPlot", "[", RowBox[{RowBox[{"Evaluate", "[", "expr", "]"}], ",", RowBox[{"{", RowBox[{"u", ",", "-", "width", ",", "width"}], "}"}], ",", RowBox[{"{", RowBox[{"v", ",", "-", "width", ",", "width"}], "}"}], ",", "\[IndentingNewLine]", "Frame", "->", "True", ",", "FrameLabel", "->", "labels", ",", "AspectRatio", "->", "1", ",", "PlotRange", "->", "All", ",", "\[IndentingNewLine]", "PlotPoints", "->", "55", ",", "MaxRecursion", "->", "1", ",", "Exclusions", "->", "None", ",", "\[IndentingNewLine]", "ColorFunctionScaling", "->", "False", ",", "ColorFunction", "->", RowBox[{"Function", "[", RowBox[{"value", ",", "\[IndentingNewLine]", RowBox[{"Blend", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"RGBColor", "[", RowBox[{"0.12", ",", "0.31", ",", "0.63"}], "]"}], ",", "White", ",", RowBox[{"RGBColor", "[", RowBox[{"0.76", ",", "0.15", ",", "0.12"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"(", RowBox[{"1", "+", RowBox[{"Sign", "[", "value", "]"}], "*", RowBox[{"Sqrt", "[", RowBox[{"Min", "[", RowBox[{"1", ",", RowBox[{"Abs", "[", "value", "]"}], "/", "peak"}], "]"}], "]"}]}], ")"}], "/", "2"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", "ImagePadding", "->", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"46", ",", "8"}], "}"}], ",", RowBox[{"{", RowBox[{"38", ",", "8"}], "}"}]}], "}"}], ",", "ImageSize", "->", "242"}], "]"}]}], "]"}], ";"}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"sliceRow", "[", RowBox[{"n_", ",", "ell_", ",", "m_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"wf", ",", "planes", ",", "width", ",", "samples", ",", "peak", ",", "labels", ",", "a", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", "wf", "=", RowBox[{"psiXYZ", "[", RowBox[{"n", ",", "ell", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", "planes", "=", RowBox[{"{", RowBox[{"wf", "/.", RowBox[{"{", RowBox[{"x", "->", "u", ",", "y", "->", "v", ",", "z", "->", "0"}], "}"}], ",", "wf", "/.", RowBox[{"{", RowBox[{"x", "->", "u", ",", "y", "->", "0", ",", "z", "->", "v"}], "}"}], ",", "\[IndentingNewLine]", "wf", "/.", RowBox[{"{", RowBox[{"x", "->", "0", ",", "y", "->", "u", ",", "z", "->", "v"}], "}"}]}], "}"}], ";", "\[IndentingNewLine]", "width", "=", "2", "*", "n", "^", "2", "+", "2", ";", "\[IndentingNewLine]", "samples", "=", RowBox[{"N", "[", RowBox[{"Subdivide", "[", RowBox[{"-", "width", ",", "width", ",", "24"}], "]"}], "]"}], ";", "\[IndentingNewLine]", "peak", "=", RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{"planes", "/.", RowBox[{"{", RowBox[{"u", "->", "a", ",", "v", "->", "b"}], "}"}], ",", RowBox[{"{", RowBox[{"a", ",", "samples"}], "}"}], ",", RowBox[{"{", RowBox[{"b", ",", "samples"}], "}"}]}], "]"}], "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{"peak", "==", "0", ",", "peak", "=", "1"}], "]"}], ";", "\[IndentingNewLine]", "labels", "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"x (a0)\"", ",", "\"y (a0)\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"x (a0)\"", ",", "\"z (a0)\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"y (a0)\"", ",", "\"z (a0)\""}], "}"}]}], "}"}], ";", "\[IndentingNewLine]", RowBox[{"Column", "[", RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"n = \"", ",", "n", ",", "\"    l = \"", ",", "ell", ",", "\"    m = \"", ",", "m"}], "}"}], "]"}], ",", "Bold"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Row", "[", RowBox[{RowBox[{"MapThread", "[", RowBox[{RowBox[{"slicePanel", "[", RowBox[{"#1", ",", "#2", ",", "width", ",", "peak"}], "]"}], "&", ",", RowBox[{"{", RowBox[{"planes", ",", "labels"}], "}"}]}], "]"}], ",", RowBox[{"Spacer", "[", "8", "]"}]}], "]"}]}], "}"}], "]"}]}], "]"}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"sliceRow", "[", RowBox[{"2", ",", "1", ",", "0"}], "]"}]], "Input"],

Cell["All allowed states   /   n = 1 through 4", "Section"],

Cell["Run this section after the worked examples. The first cell should return {10, 16, 30}. The next cell computes the normalization of each function; every norm should be 1. The last three cells generate the figures, with one orbital per row in part C.", "Text"],

Cell[BoxData[RowBox[{"radialPairs", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"n", ",", "ell"}], "}"}], ",", RowBox[{"{", RowBox[{"n", ",", "1", ",", "4"}], "}"}], ",", RowBox[{"{", RowBox[{"ell", ",", "0", ",", "n", "-", "1"}], "}"}]}], "]"}], ",", "1"}], "]"}], ";", "\[IndentingNewLine]", "angularPairs", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"ell", ",", "m"}], "}"}], ",", RowBox[{"{", RowBox[{"ell", ",", "0", ",", "3"}], "}"}], ",", RowBox[{"{", RowBox[{"m", ",", "-", "ell", ",", "ell"}], "}"}]}], "]"}], ",", "1"}], "]"}], ";", "\[IndentingNewLine]", "orbitals", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"n", ",", "ell", ",", "m"}], "}"}], ",", RowBox[{"{", RowBox[{"n", ",", "1", ",", "4"}], "}"}], ",", RowBox[{"{", RowBox[{"ell", ",", "0", ",", "n", "-", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"m", ",", "-", "ell", ",", "ell"}], "}"}]}], "]"}], ",", "2"}], "]"}], ";", "\[IndentingNewLine]", "Length", "/@", RowBox[{"{", RowBox[{"radialPairs", ",", "angularPairs", ",", "orbitals"}], "}"}]}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"normTable", "[", RowBox[{"states_", ",", "fn_", ",", "headers_"}], "]"}], ":=", RowBox[{"Grid", "[", RowBox[{"\[IndentingNewLine]", RowBox[{"Prepend", "[", RowBox[{RowBox[{"Map", "[", RowBox[{RowBox[{"Function", "[", RowBox[{"state", ",", RowBox[{"Append", "[", RowBox[{"state", ",", RowBox[{"Apply", "[", RowBox[{"fn", ",", "state"}], "]"}]}], "]"}]}], "]"}], ",", "states"}], "]"}], ",", "headers"}], "]"}], ",", "\[IndentingNewLine]", "Alignment", "->", "Right", ",", "Dividers", "->", RowBox[{"{", RowBox[{"False", ",", RowBox[{"{", RowBox[{"False", ",", "True"}], "}"}]}], "}"}], ",", "Spacings", "->", RowBox[{"{", RowBox[{"1.2", ",", "0.35"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[{RowBox[{"normTable", "[", RowBox[{"radialPairs", ",", "radialNorm", ",", RowBox[{"{", RowBox[{"\"n\"", ",", "\"l\"", ",", "\"radial norm\""}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"normTable", "[", RowBox[{"angularPairs", ",", "angularNorm", ",", RowBox[{"{", RowBox[{"\"l\"", ",", "\"m\"", ",", "\"angular norm\""}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"normTable", "[", RowBox[{"orbitals", ",", "fullNorm", ",", RowBox[{"{", RowBox[{"\"n\"", ",", "\"l\"", ",", "\"m\"", ",", "\"full norm\""}], "}"}]}], "]"}]}], "}"}], "}"}], ",", "\[IndentingNewLine]", "Alignment", "->", RowBox[{"{", RowBox[{"Left", ",", "Top"}], "}"}], ",", "Spacings", "->", RowBox[{"{", RowBox[{"3", ",", "0"}], "}"}]}], "]"}]}]], "Input"],

Cell["A   /   10 radial plots", "Subsection"],

Cell[BoxData[RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{"Print", "[", RowBox[{"Apply", "[", RowBox[{"radialPlot", ",", "state"}], "]"}], "]"}], ",", RowBox[{"{", RowBox[{"state", ",", "radialPairs"}], "}"}]}], "]"}], ";"}]], "Input"],

Cell["B   /   16 angular isosurfaces", "Subsection"],

Cell[BoxData[RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{"Print", "[", RowBox[{"Apply", "[", RowBox[{"angularPlot", ",", "state"}], "]"}], "]"}], ",", RowBox[{"{", RowBox[{"state", ",", "angularPairs"}], "}"}]}], "]"}], ";"}]], "Input"],

Cell["C   /   30 rows of three slices", "Subsection"],

Cell[BoxData[RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{"Print", "[", RowBox[{"Apply", "[", RowBox[{"sliceRow", ",", "state"}], "]"}], "]"}], ",", RowBox[{"{", RowBox[{"state", ",", "orbitals"}], "}"}]}], "]"}], ";"}]], "Input"],

Cell["Compare the output with Figures 4\:20136 of the handout. A useful extra check is the (4, 3, \:22122) orbital: its Cartesian angular polynomial is proportional to xyz, so all three coordinate planes are nodal even though its full normalization is 1.", "Text"],

Cell["Source: Project 4, The hydrogen atom wavefunctions. Radial definition and normalization: pp. 16\:201318. Real spherical harmonics and their isosurfaces: pp. 19\:201323. Full wavefunctions and coordinate-plane slices: pp. 24\:201326.", "Text"]
},
CellContext -> Notebook, WindowSize -> {1080, 820},
WindowTitle -> "Project 4 | Hydrogen atom wavefunctions",
StyleDefinitions -> "Default.nb"]
